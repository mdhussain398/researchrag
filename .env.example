# ResearchRAG Environment Configuration

# Optional: Google Gemini API Key (Recommended for high-speed free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Groq API Key (High-speed Llama-3 inference)
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# HuggingFace Token (Optional, avoids rate limit warnings)
HF_TOKEN=your_huggingface_token_here

# App Environment Settings
APP_ENV=development
LOG_LEVEL=INFO
